<section class="section">
  <div class="wrap">
    <div class="sec-hd">
      <div class="t disp">Plague today — an ancient disease made ordinary</div>
      <div class="sub">Modern Yersinia pestis · 2026</div>
    </div>
    <div class="modern-row">
      <div class="mod-stat"><div class="v">~2,000</div><div class="k">Global cases per year · mostly Africa</div></div>
      <div class="mod-stat"><div class="v">~7</div><div class="k">Annual US cases · SW states · rural</div></div>
