<!doctype html>
<html lang="en">
  {% set assetVersion = "20260728-1341" %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    <link rel="icon" href="/assets/img/favicon.ico?v={{ assetVersion }}" sizes="32x32">
    <link rel="icon" href="/assets/img/favicon-192.png?v={{ assetVersion }}" type="image/png" sizes="192x192">
    <link rel="icon" href="/assets/img/favicon-512.png?v={{ assetVersion }}" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png?v={{ assetVersion }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@100;200;300;400;500;600;700&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Libre+Baskerville:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9CMETG9RBQ"></script>
    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-9CMETG9RBQ');</script>
    {% for item in headLinks %}
      {{ item | safe }}
    {% endfor %}
    {% for item in headScripts %}
      {{ item | safe }}
    {% endfor %}
    {% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}?v={{ assetVersion }}">{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
  </head>
  <body class="site-shell site-shell-{{ active | default('dashboard') }}{% if bodyClass %} {{ bodyClass }}{% endif %}">
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="site-header__inner">
        <button class="site-brand" type="button" data-site-menu-trigger aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-sidenav">
          <img class="site-brand__logo" src="/assets/img/outbreaks-logo.png?v={{ assetVersion }}" alt="Outbreaks">
          <span class="site-brand__menu" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <nav class="site-topnav" aria-label="Primary navigation" data-site-topnav>
          <span class="site-topnav__ind" data-site-topnav-ind aria-hidden="true"></span>
          {% for item in navigation %}
            {% if item.children %}
              <div class="site-topnav-group{% if activeGroup == item.key %} is-active{% endif %}">
                <button type="button" class="site-topnav-group-trigger" aria-haspopup="true" aria-expanded="false">{{ item.label }}<svg class="caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg></button>
                <div class="site-topnav-dropdown">
                  {% for child in item.children %}
                    <a href="{{ child.href }}"{% if active == child.key %} class="is-active" aria-current="page"{% endif %}>
                      <span class="site-topnav-dropdown-label">{{ child.label }}</span>
                      <span class="site-topnav-dropdown-deck">{{ child.deck }}</span>
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <a href="{{ item.href }}"{% if active == item.key %} class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endif %}
          {% endfor %}
        </nav>
        {% if pageActions == "recordModes" %}
          <div class="site-header__tools">
            <div class="site-mode-toggle" aria-label="Record display mode">
              <button class="mode-btn active" id="btn-proportional" title="Area proportional to estimated deaths">Scaled</button>
              <button class="mode-btn" id="btn-equal" title="Equal area for each disease">Equal</button>
            </div>
          </div>
        {% endif %}
      </div>
    </header>

    <div class="site-scrim" data-site-scrim hidden></div>
    <aside class="site-sidenav" id="site-sidenav" data-site-sidenav aria-hidden="true">
      <nav class="site-nav" aria-label="Primary navigation">
        {% for item in navigation %}
          {% if item.children %}
            <span class="site-nav-group-label">{{ item.label }}</span>
            {% for child in item.children %}
              <a href="{{ child.href }}" class="{% if active == child.key %}is-active{% endif %}">
                <span>{{ child.label }}</span>
                <small>{{ child.deck }}</small>
              </a>
            {% endfor %}
          {% else %}
            <a href="{{ item.href }}" class="{% if active == item.key %}is-active{% endif %}">
              <span>{{ item.label }}</span>
              <small>{{ item.deck }}</small>
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    </aside>

    <main class="site-main" id="content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-kicker">Outbreaks</p>
        <p class="site-footer__fine">Prototype for editorial and educational use. Verify figures with cited public-health authorities before operational use.<br>Data and reporting drawn from the <a href="https://www.who.int/" target="_blank" rel="noopener">World Health Organization</a>, the <a href="https://www.cdc.gov/" target="_blank" rel="noopener">CDC</a>, and <a href="https://www.msf.org/" target="_blank" rel="noopener">Médecins Sans Frontières</a>.</p>
        <a class="site-footer__credit" href="https://rondomingue.com" target="_blank" rel="noopener">Created by rondomingue.com&nbsp;↗</a>
      </div>
    </footer>

    <script src="/assets/js/site.js?v={{ assetVersion }}"></script>
    {% if pageJs %}<script src="{{ pageJs }}?v={{ assetVersion }}"></script>{% endif %}
  </body>
</html>
