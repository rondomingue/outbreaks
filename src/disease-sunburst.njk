---
layout: layouts/base.njk
title: "Virulent Diseases · 2000 Years — Outbreak Intelligence"
active: record
permalink: /disease-sunburst.html
pageCss: /assets/css/disease-sunburst.css
pageJs: /assets/js/disease-sunburst.js
pageActions: recordModes
bodyClass: full-bleed-record
headScripts:
  - "<script src=\"https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js\"></script>"
---
<!-- ════ TOP NAV ════════════════════════════════════════════════════════════ -->
<!-- ════ STAGE ══════════════════════════════════════════════════════════════ -->
<div id="stage">
  <div id="chart-area">
    <div id="chart"></div>
    <div id="center-overlay">
      <svg viewBox="-80 -80 160 160" xmlns="http://www.w3.org/2000/svg">

        <!-- Background fill rings -->
        <circle r="79" fill="rgba(3,5,7,.88)"/>
        <circle r="72" fill="none" stroke="rgba(180,200,255,.05)" stroke-width="1"/>

        <!-- Conic-gradient-style quadrant tints matching class colors -->
        <!-- VIRAL top-right -->
        <path d="M 0,0 L 60,-60 A 80,80 0 0,1 60,60 Z" fill="rgba(200,64,56,.04)"/>
        <!-- BACTERIAL lower area -->
        <path d="M 0,0 L 60,60 A 80,80 0 0,1 -60,60 Z" fill="rgba(184,120,24,.03)"/>
        <!-- PARASITIC left area -->
        <path d="M 0,0 L -60,60 A 80,80 0 0,1 -60,-60 Z" fill="rgba(30,120,96,.03)"/>
        <!-- OTHER top-left -->
        <path d="M 0,0 L -60,-60 A 80,80 0 0,1 60,-60 Z" fill="rgba(80,72,152,.03)"/>

        <!-- Dashed orbital ring -->
        <circle r="60" fill="none" stroke="rgba(180,200,255,.08)" stroke-width="0.6" stroke-dasharray="2,3"/>

        <!-- Inner dark disc -->
        <circle r="38" fill="rgba(3,5,7,.82)" stroke="rgba(180,200,255,.06)" stroke-width="0.8"/>

        <!-- ── DATE SPAN: the range the chart covers ── -->
        <!-- Upper year -->
        <text x="0" y="-8" text-anchor="middle"
              font-size="7.5" font-family="'Space Mono', monospace" font-weight="400"
              letter-spacing="2" fill="rgba(140,155,190,.48)">EPIDEMIC</text>

        <!-- Brand word -->
        <text x="0" y="7" text-anchor="middle"
              font-size="16" font-family="'Fraunces', serif" font-weight="300"
              font-style="italic" letter-spacing="-0.2" fill="rgba(208,216,238,.82)">record</text>

        <!-- Thin rule -->
        <line x1="-14" y1="12" x2="14" y2="12" stroke="rgba(200,64,56,.35)" stroke-width="0.6"/>

        <!-- Temporal span -->
        <text x="0" y="22" text-anchor="middle"
              font-size="6.5" font-family="'Space Mono', monospace" font-weight="400"
              letter-spacing="1.2" fill="rgba(100,115,150,.52)">430 BCE — 2026</text>

      </svg>
    </div>
  </div>

  <div id="page-title">
    <h1>Virulent diseases of the<br>last <em>2,000 years</em></h1>
    <div class="sub">Click any segment · 29 pathogens · cube-root scaled</div>
  </div>

  <div id="legend-bar">
    <div class="leg-item"><div class="leg-swatch" style="background:#c84038"></div>Viral</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#b87818"></div>Bacterial</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#1e7860"></div>Parasitic</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#504898"></div>Other</div>
    <div class="leg-hint">Area ∝ deaths (cube-root)</div>
  </div>

  <div id="hover-hint">Hover / click</div>
</div>

<!-- ════ SLIDING INFO PANEL ═════════════════════════════════════════════════ -->
<div id="info-panel">
  <button id="info-close" aria-label="Close panel">✕</button>
  <div id="info-inner">
    <div id="info-empty">
      <div class="empty-rings">
        <span style="width:52px;height:52px"></span>
        <span style="width:36px;height:36px"></span>
        <span style="width:20px;height:20px"></span>
      </div>
      <p>Click any segment<br>to explore</p>
    </div>
    <div id="info-filled">
      <div id="info-class-badge">
        <span id="info-class-dot"></span>
        <span id="info-class-name"></span>
      </div>
      <div id="info-name"></div>
      <div id="info-img-wrap">
        <img id="info-img" alt="" />
        <div id="info-img-credit"></div>
      </div>
      <div id="info-deaths-row">
        <div id="info-deaths-label">Estimated deaths</div>
        <div id="info-deaths-val"></div>
      </div>
      <div id="info-period"></div>
      <div id="info-note"></div>
      <div id="info-stats">
        <div class="istat-row">
          <div class="istat"><div class="v" id="is-cfr">—</div><div class="k">Peak CFR</div></div>
          <div class="istat"><div class="v" id="is-vax">—</div><div class="k">Vaccine</div></div>
        </div>
        <div class="istat-row">
          <div class="istat"><div class="v" id="is-first">—</div><div class="k">First recorded</div></div>
          <div class="istat"><div class="v" id="is-status">—</div><div class="k">Status 2026</div></div>
        </div>
      </div>
    </div>
  </div>
</div>
